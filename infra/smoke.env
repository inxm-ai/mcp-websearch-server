# Environment for `docker run` in the image smoke (infra/run-image-smoke.sh)
# and the image start check (scripts/test-image-starts.sh, on top of the
# chart's env). The deployment injects these through the chart's values; a
# bare container needs them to be itself rather than the bridge's bundled
# sample. Keep the command and base path in step with infra/helm/values.yaml.
MCP_SERVER_COMMAND=/usr/local/bin/mcp-websearch
MCP_BASE_PATH=/api/mcp-websearch-server
# One browser is enough to prove a render inside the image.
RENDER_ENABLED=true
RENDER_POOL_SIZE=1
